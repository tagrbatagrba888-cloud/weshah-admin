rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function notificationCollection(name) {
      return name in ['weshahPushSubscriptions', 'weshahPushLimits', 'weshahPushCampaigns'];
    }
    function notificationServer() {
      return request.auth != null && request.auth.uid == '8wGuAyip2ROrhSklnmz6YYlF1Xx2';
    }
    match /{topLevel}/{document=**} {
      allow read, write: if !notificationCollection(topLevel) || notificationServer();
    }
  }
}
